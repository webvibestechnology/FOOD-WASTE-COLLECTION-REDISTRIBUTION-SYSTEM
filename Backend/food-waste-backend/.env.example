# Food Waste Collection & Redistribution System - Backend Environment Configuration
# Copy this file to .env or pass these as environment variables to the Spring Boot application.
# NEVER commit production passwords or JWT secrets to version control.

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/food_waste_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JWT Authentication
# Base64-encoded HMAC-SHA256 secret (minimum 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
PORT=8080

# Spring Profiles & Hibernate
SPRING_PROFILES_ACTIVE=dev
JPA_DDL_AUTO=update
